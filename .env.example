# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Dashboard Configuration
EXPO_PUBLIC_BOT_API_URL=https://your-bot.render.com
EXPO_PUBLIC_WS_URL=wss://your-bot.render.com
EXPO_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id_here
EXPO_PUBLIC_DISCORD_REDIRECT_URI=https://your-dashboard.com/auth/callback

# Server
DASHBOARD_PORT=3000
NODE_ENV=production
