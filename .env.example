# ─── Discord Bot (server-side, NEVER expose to client) ────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here   # Required for token exchange on backend

# ─── Dashboard / Mobile App ───────────────────────────────────────────────────
# Your deployed Node.js bot URL (Render / Railway / VPS)
# The bot must expose:
#   POST /auth/discord/exchange   → { code, code_verifier, redirect_uri } → { access_token }
#   GET  /guilds/ids              → string[]  (guild IDs bot is in)
#   GET  /stats                   → BotStats
#   GET  /queue/:guildId          → QueueState
EXPO_PUBLIC_BOT_API_URL=https://your-bot.render.com

# WebSocket for real-time sync (optional)
EXPO_PUBLIC_WS_URL=wss://your-bot.render.com

# ─── Discord OAuth2 ────────────────────────────────────────────────────────────
# Your Discord Application Client ID (safe to expose to client)
# Found at: https://discord.com/developers/applications → OAuth2 → Client ID
EXPO_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id_here

# Register this redirect URI in Discord Developer Portal → OAuth2 → Redirects:
#   denzzmusic://oauth
# (or for Expo Go: exp://YOUR_LAN_IP:PORT  — see expo-auth-session docs)

# ─── Optional ──────────────────────────────────────────────────────────────────
# Internal API key for bot API calls (set on your bot server)
EXPO_PUBLIC_BOT_API_KEY=your_internal_api_key

# Server config
DASHBOARD_PORT=3000
NODE_ENV=production
